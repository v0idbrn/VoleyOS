NEXT_PUBLIC_BUILD_TARGET=cloud
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_DEV_UNLOCK=true
PAYMENT_WEBHOOK_SECRET=change-me
